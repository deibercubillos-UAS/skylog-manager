# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — sin "/" inicial para cubrir node_modules en cualquier subcarpeta
# (docs/, demo-enterprise/, railway-robot/, etc.), no solo la raíz del repo
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# claude / local tooling — .claude/skills/ y .claude/settings.json SÍ se versionan
# (skills instaladas para el proyecto, ej. ui-ux-pro-max, y los plugins/marketplaces
# compartidos por el equipo); el resto de .claude/ (permisos locales, settings.local.json)
# sigue ignorado.
.claude/*
!.claude/skills
!.claude/settings.json
.clone/
__pycache__/
*.pyc
.coverage
coverage-ui.json
# docs/ — descomentado para versionar documentación del proyecto
# docs/
graphify-out/

# archivos temporales de Office (lock files)
~$*
*.tmp

# parches sueltos
*.patch

# Evidencia de pruebas del emulador (no versionar)
mobile/emulator-*.png

# Android release signing (NUNCA versionar)
*.keystore
*.jks
android/keystore.properties
