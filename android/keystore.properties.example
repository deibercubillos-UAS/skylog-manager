# Plantilla de credenciales de firma del release (Android).
# Copia este archivo a `android/keystore.properties` y rellena TUS valores.
# El archivo real NO se versiona (.gitignore: keystore.properties, *.keystore, *.jks).
# Lo lee android/app/build.gradle (signingConfigs.release); si no existe, el release sale SIN firmar.

# Ruta del keystore, relativa a la carpeta android/ (donde se generó con keytool).
storeFile=bitafly-upload.keystore

# Contraseña del keystore (la que elegiste al correr keytool). Guárdala en tu gestor de contraseñas.
storePassword=CAMBIA_ESTA_CONTRASEÑA

# Alias de la clave dentro del keystore.
keyAlias=bitafly

# Contraseña de la clave (suele ser la misma del keystore).
keyPassword=CAMBIA_ESTA_CONTRASEÑA
