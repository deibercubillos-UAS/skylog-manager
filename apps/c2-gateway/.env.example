# c2-gateway — variables de entorno requeridas (configúralas en Railway/Fly,
# nunca las commitees con valores reales).

# Puerto del broker MQTT al que se conecta Pilot 2/el RC. Railway necesita
# exponerlo como TCP Proxy (ver README) — no es el mismo puerto HTTP.
C2_MQTT_PORT=1883

# Puerto HTTP del health check — Railway/Fly lo inyectan automáticamente
# como PORT, normalmente no hace falta fijarlo a mano.
PORT=8080

# Secreto compartido MVP (ver nota de seguridad en src/index.js) — el
# cliente MQTT (RC/Pilot 2) debe autenticar con este password. Genera uno
# random real, nunca "changeme".
C2_SHARED_SECRET=

# Mismo proyecto Supabase que usa la app Next.js (branch develop-v2) —
# SUPABASE_URL es la URL del proyecto, NO la de un branch distinto.
SUPABASE_URL=https://bqimtkwzayewwubgsaji.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
